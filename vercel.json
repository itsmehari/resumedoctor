{
  "framework": "nextjs",
  "buildCommand": "npx prisma migrate deploy && npm run build",
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/trial-expiry-reminders",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/trial-expired-downgrade",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/win-back-inactive",
      "schedule": "0 3 * * 1"
    }
  ]
}
